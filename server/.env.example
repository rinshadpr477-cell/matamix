# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Example for local MongoDB: mongodb://localhost:27017/task_manager
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/task_manager?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/task_manager

# CORS Configuration (allowed origins separated by comma)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MUTATION_RATE_LIMIT_MAX_REQUESTS=60
